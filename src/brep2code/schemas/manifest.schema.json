{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brep2code.local/schemas/manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "split", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "split": {"enum": ["smoke", "train", "eval"]},
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
